{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "json.schemaDownload.enable": true,
  "json.schemas": [
    {
      "fileMatch": ["/tsconfig.json", "/tsconfig.*.json"],
      "schema": {
        "type": "object",
        "allowTrailingCommas": true,
        "additionalProperties": true
      }
    }
  ]
}

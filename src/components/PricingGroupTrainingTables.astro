---
import PricingPackagesTable from "./PricingPackagesTable.astro";
import { groupTrainingPackages } from "../data/siteData";

const { subtitle, footnote, totalColumnLabel, tables } = groupTrainingPackages;

const tableIds = ["duo", "trio", "quad"] as const;
const groupSizes = [2, 3, 4] as const;
---

<div class="max-w-6xl mx-auto mb-16">
  <div class="text-center mb-10">
    <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-3">
      Group Training
    </h2>
    <p class="text-lg md:text-xl text-text-secondary">{subtitle}</p>
  </div>

  <div class="flex flex-col gap-8">
    <div class="min-w-0" data-pricing-group-root>
      <div
        class="pricing-group-tabs"
        role="tablist"
        aria-label="Group training size"
      >
        {
          tables.map((table, index) => {
            const id = tableIds[index] ?? `group-${index}`;
            return (
              <button
                type="button"
                role="tab"
                class:list={["pricing-group-tab", index === 0 && "is-active"]}
                data-pricing-group-tab={id}
                aria-selected={index === 0 ? "true" : "false"}
                aria-label={table.title}
              >
                <i
                  class="ri-group-line pricing-group-tab-icon"
                  aria-hidden="true"
                ></i>
                <span class="tabular-nums">{groupSizes[index]}</span>
              </button>
            );
          })
        }
      </div>

      <div class="mt-6">
        {
          tables.map((table, index) => {
            const id = tableIds[index] ?? `group-${index}`;
            return (
              <div
                role="tabpanel"
                data-pricing-group-panel={id}
                hidden={index !== 0}
              >
                <PricingPackagesTable
                  rows={table.rows}
                  tableId={id}
                  totalColumnLabel={totalColumnLabel}
                />
              </div>
            );
          })
        }
      </div>

      <p class="mt-4 text-sm text-text-tertiary leading-relaxed">{footnote}</p>
    </div>

    <div class="flex justify-center">
      <a
        href="/contact"
        class="inline-flex min-w-56 items-center justify-center gap-3 rounded-lg bg-primary px-8 py-4 text-lg font-bold text-bg-primary transition-all hover:bg-primary-hover"
      >
        Get Started
        <i class="ri-arrow-right-line" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</div>

<script>
  import "../scripts/pricing-group-training.ts";
</script>

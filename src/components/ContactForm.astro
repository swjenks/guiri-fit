---
import type { Locale } from "../i18n/config";
import { getSiteContent } from "../data/getSiteContent";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { siteData, ui } = getSiteContent(locale);
const mailto = `mailto:${siteData.email}`;
---

<form class="bg-bg-primary p-8 rounded-xl border border-border-primary space-y-6">
  <div
    class="rounded-lg border border-border-primary/60 bg-bg-secondary/40 p-4 text-sm leading-relaxed text-text-secondary"
    role="status"
  >
    <p>
      {ui.contactFormNotice}{" "}
      <a
        href={mailto}
        class="font-medium text-primary hover:text-primary-hover underline-offset-2 hover:underline"
      >
        {siteData.email}
      </a>
      .
    </p>
  </div>

  <div>
    <label for="name" class="block text-text-primary font-semibold mb-2">
      {ui.contactFormFullName}
    </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      class="w-full px-4 py-3 bg-bg-secondary border border-border-primary rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:border-border-accent transition-colors"
      placeholder={ui.contactFormNamePlaceholder}
    />
  </div>

  <div>
    <label for="email" class="block text-text-primary font-semibold mb-2">
      {ui.contactFormEmail}
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full px-4 py-3 bg-bg-secondary border border-border-primary rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:border-border-accent transition-colors"
      placeholder={ui.contactFormEmailPlaceholder}
    />
  </div>

  <div>
    <label for="whatsapp" class="block text-text-primary font-semibold mb-2">
      {ui.contactFormWhatsApp}
    </label>
    <input
      type="tel"
      id="whatsapp"
      name="whatsapp"
      class="w-full px-4 py-3 bg-bg-secondary border border-border-primary rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:border-border-accent transition-colors"
      placeholder={ui.contactFormWhatsAppPlaceholder}
    />
  </div>

  <div>
    <label for="message" class="block text-text-primary font-semibold mb-2">
      {ui.contactFormMessage}
    </label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      class="w-full px-4 py-3 bg-bg-secondary border border-border-primary rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:border-border-accent transition-colors resize-none"
      placeholder={ui.contactFormMessagePlaceholder}
    ></textarea>
  </div>

  <button
    type="submit"
    class="flex w-full items-center justify-center gap-3 rounded-lg bg-primary px-8 py-4 text-lg font-bold text-bg-primary transition-all hover:bg-primary-hover"
  >
    {ui.contactFormSubmit}
    <i class="ri-send-plane-line"></i>
  </button>
</form>

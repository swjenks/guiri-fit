---
---

<form class="bg-bg-primary p-8 rounded-xl border border-border-primary space-y-6">
  <div>
    <label for="name" class="block text-text-primary font-semibold mb-2">
      Full Name
    </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      class="w-full px-4 py-3 bg-bg-secondary border border-border-primary rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:border-border-accent transition-colors"
      placeholder="John Doe"
    />
  </div>

  <div>
    <label for="email" class="block text-text-primary font-semibold mb-2">
      Email Address
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full px-4 py-3 bg-bg-secondary border border-border-primary rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:border-border-accent transition-colors"
      placeholder="john@example.com"
    />
  </div>

  <div>
    <label for="phone" class="block text-text-primary font-semibold mb-2">
      Phone Number
    </label>
    <input
      type="tel"
      id="phone"
      name="phone"
      class="w-full px-4 py-3 bg-bg-secondary border border-border-primary rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:border-border-accent transition-colors"
      placeholder="+1 (555) 123-4567"
    />
  </div>

  <div>
    <label for="message" class="block text-text-primary font-semibold mb-2">
      Message
    </label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      class="w-full px-4 py-3 bg-bg-secondary border border-border-primary rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:border-border-accent transition-colors resize-none"
      placeholder="Tell us about your fitness goals..."
    ></textarea>
  </div>

  <button
    type="submit"
    class="w-full bg-primary hover:bg-primary-hover text-bg-primary px-8 py-4 rounded-lg font-bold text-lg transition-all transform hover:scale-105 flex items-center justify-center gap-3"
  >
    Send Message
    <i class="ri-send-plane-line"></i>
  </button>
</form>


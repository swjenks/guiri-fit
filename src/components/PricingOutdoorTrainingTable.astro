---
import PricingPackagesTable from "./PricingPackagesTable.astro";
import { outdoorTrainingPackages } from "../data/siteData";

const { subtitle, rows } = outdoorTrainingPackages;
---

<div class="max-w-6xl mx-auto mb-16">
  <div class="text-center mb-10">
    <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-3">
      Outdoor Training (Seasonal)
    </h2>
    <p class="text-lg md:text-xl text-text-secondary">{subtitle}</p>
  </div>

  <div class="flex flex-col gap-8">
    <div class="min-w-0">
      <PricingPackagesTable rows={rows} tableId="outdoor-training" />
    </div>

    <div class="flex justify-center">
      <a
        href="/contact"
        class="inline-flex min-w-[14rem] items-center justify-center gap-3 rounded-lg bg-primary px-8 py-4 text-lg font-bold text-bg-primary transition-all hover:bg-primary-hover"
      >
        Get Started
        <i class="ri-arrow-right-line" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</div>

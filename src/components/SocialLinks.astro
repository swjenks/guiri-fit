---
import {
  siteData,
  socialLinks,
  socialLinksEnabled,
  socialMediaComingSoonNote,
} from "../data/siteData";

interface Props {
  variant?: "footer" | "contact";
}

const { variant = "footer" } = Astro.props;

const iconWrapperClass =
  variant === "contact"
    ? "flex h-12 w-12 items-center justify-center rounded-lg bg-bg-tertiary text-text-tertiary"
    : "flex h-10 w-10 items-center justify-center rounded-lg bg-bg-secondary text-text-tertiary";

const linkWrapperClass =
  variant === "contact"
    ? `${iconWrapperClass} transition-all hover:bg-primary hover:text-bg-primary`
    : `${iconWrapperClass} transition-all hover:bg-primary hover:text-bg-primary`;
---

<div>
  <div class="flex space-x-4">
    {
      socialLinks.map((social) => {
        const href =
          siteData.social[social.name as keyof typeof siteData.social];

        return socialLinksEnabled ? (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class={linkWrapperClass}
            aria-label={social.label}
          >
            <i class={`${social.icon} text-xl`} aria-hidden="true"></i>
          </a>
        ) : (
          <span
            class={`${iconWrapperClass} opacity-60`}
            aria-label={`${social.label} (coming soon)`}
          >
            <i class={`${social.icon} text-xl`} aria-hidden="true"></i>
          </span>
        );
      })
    }
  </div>
  {
    !socialLinksEnabled && (
      <p class="mt-3 text-sm leading-relaxed text-text-tertiary">
        {socialMediaComingSoonNote}
      </p>
    )
  }
</div>

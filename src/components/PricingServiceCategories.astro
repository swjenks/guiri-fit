---
import type { PaymentPlanCategory } from "../data/siteData";

interface Props {
  categories: PaymentPlanCategory[];
}

const { categories } = Astro.props;
---

<div class="space-y-16 max-w-5xl mx-auto">
  {
    categories.map((category) => (
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-8 text-center">
          {category.title}
        </h2>
        {category.comingSoonNote ? (
          <p class="text-lg md:text-xl text-text-secondary text-center max-w-2xl mx-auto leading-relaxed">
            {category.comingSoonNote}
          </p>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {category.plans.map((plan) => (
              <div class="card-interactive bg-bg-primary p-6 rounded-xl border border-border-primary text-center">
                <h3 class="text-xl font-bold text-text-primary mb-3">
                  {plan.type}
                </h3>
                <p class="text-text-secondary leading-relaxed">
                  {plan.description}
                </p>
              </div>
            ))}
          </div>
        )}
      </div>
    ))
  }
</div>

---
import { faqs } from "../data/siteData";

type FaqItem = (typeof faqs)[number];

interface Props {
  items?: FaqItem[];
  title?: string;
  subtitle?: string;
  id?: string;
  showFooter?: boolean;
}

const {
  items = faqs,
  title = "Frequently Asked Questions",
  subtitle,
  id = "faq",
  showFooter = true,
} = Astro.props;
---

<section id={id} class="py-20 bg-bg-secondary">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">
        {title}
      </h2>
      {
        subtitle && (
          <p class="text-xl text-text-secondary max-w-2xl mx-auto">{subtitle}</p>
        )
      }
    </div>

    <div class="space-y-4">
      {
        items.map((faq) => (
          <details class="faq-item bg-bg-primary rounded-xl border border-border-primary hover:border-border-accent transition-all">
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <h3 class="text-xl font-bold text-text-primary pr-4">
                {faq.question}
              </h3>
              <i class="faq-icon ri-arrow-down-s-line text-2xl text-primary transition-transform shrink-0" aria-hidden="true" />
            </summary>
            <div class="px-6 pb-6">
              <p class="text-text-secondary leading-relaxed whitespace-pre-line">
                {
                  faq.answerLink ? (
                    <>
                      {faq.answer.split(faq.answerLink.label)[0]}
                      <a
                        href={faq.answerLink.href}
                        class="font-medium text-primary hover:text-primary-hover underline-offset-2 hover:underline"
                      >
                        {faq.answerLink.label}
                      </a>
                      {faq.answer.split(faq.answerLink.label)[1] ?? ""}
                    </>
                  ) : (
                    faq.answer
                  )
                }
              </p>
            </div>
          </details>
        ))
      }
    </div>

    {
      showFooter && (
        <div class="text-center mt-12">
          <p class="text-text-tertiary mb-4">Still have questions?</p>
          <a
            href="/contact"
            class="btn-interactive inline-flex items-center gap-3 rounded-lg bg-primary px-8 py-4 text-lg font-bold text-bg-primary hover:bg-primary-hover"
          >
            Contact Me
            <i class="ri-arrow-right-line" aria-hidden="true"></i>
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }
</style>

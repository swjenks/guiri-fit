---
import type { Locale } from "../i18n/config";
import { localizedPath } from "../i18n/paths";
import { getSiteContent } from "../data/getSiteContent";

type FaqItem = ReturnType<typeof getSiteContent>["faqs"][number];

interface Props {
  items?: FaqItem[];
  title?: string;
  subtitle?: string;
  id?: string;
  showFooter?: boolean;
}

const locale = (Astro.currentLocale ?? "en") as Locale;
const { faqs, ui, contactHref } = getSiteContent(locale);

const {
  items = faqs,
  title = ui.faqTitle,
  subtitle,
  id = "faq",
  showFooter = true,
} = Astro.props;
---

<section id={id} class="py-20 bg-bg-secondary">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">
        {title}
      </h2>
      {
        subtitle && (
          <p class="text-xl text-text-secondary max-w-2xl mx-auto">{subtitle}</p>
        )
      }
    </div>

    <div class="space-y-4">
      {
        items.map((faq) => (
          <details class="faq-item card-bordered card-interactive-border bg-bg-primary">
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <h3 class="text-xl font-bold text-text-primary pr-4">
                {faq.question}
              </h3>
              <i class="faq-icon ri-arrow-down-s-line text-2xl text-primary shrink-0" aria-hidden="true" />
            </summary>
            <div class="px-6 pb-6">
              <p class="text-text-secondary leading-relaxed whitespace-pre-line">
                {
                  "answerLink" in faq && faq.answerLink ? (
                    <>
                      {faq.answer.split(faq.answerLink.label)[0]}
                      <a
                        href={localizedPath(locale, faq.answerLink.href)}
                        class="font-medium text-primary hover:text-primary-hover underline-offset-2 hover:underline"
                      >
                        {faq.answerLink.label}
                      </a>
                      {faq.answer.split(faq.answerLink.label)[1] ?? ""}
                    </>
                  ) : (
                    faq.answer
                  )
                }
              </p>
            </div>
          </details>
        ))
      }
    </div>

    {
      showFooter && (
        <div class="text-center mt-12">
          <p class="text-text-tertiary mb-4">{ui.faqStillQuestions}</p>
          <a
            href={contactHref}
            class="btn-interactive inline-flex items-center gap-3 rounded-lg bg-primary px-8 py-4 text-lg font-bold text-bg-primary hover:bg-primary-hover"
          >
            {ui.faqContact}
            <i class="ri-arrow-right-line" aria-hidden="true"></i>
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    display: inline-block;
    transition: transform 0.2s ease-out;
  }

  details[open] .faq-icon {
    transform: rotate(180deg);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .faq-item:not([open]) summary:hover .faq-icon {
      transform: translateY(0.25rem);
    }

    .faq-item[open] summary:hover .faq-icon {
      transform: rotate(180deg) translateY(-0.25rem);
    }
  }
</style>

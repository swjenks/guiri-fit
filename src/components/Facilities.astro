---
import { Image } from "astro:assets";
import { facilities } from "../data/siteData";
---

<section id="facilities" class="py-20 bg-bg-primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">
        Where We Train
      </h2>
      <p class="text-xl text-text-secondary max-w-2xl mx-auto">
        Indoor and outdoor options for your training
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        facilities.map((facility) => (
          <div class="group bg-bg-secondary rounded-xl overflow-hidden border border-border-primary hover:border-border-accent transition-all transform hover:scale-105">
            <div class="relative h-64 overflow-hidden">
              <Image
                src={facility.image}
                alt={facility.title}
                width={800}
                height={600}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-linear-to-t from-bg-primary/80 to-transparent" />
              <div class="absolute bottom-4 left-4 right-4">
                <h3 class="text-xl font-bold text-text-primary mb-2">
                  {facility.title}
                </h3>
              </div>
            </div>
            <div class="p-6">
              <p class="text-text-tertiary leading-relaxed">
                {facility.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

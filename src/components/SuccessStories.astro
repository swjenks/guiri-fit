---
import { Image } from 'astro:assets';
import { successStories } from '../data/siteData';
---

<section id="success-stories" class="py-20 bg-bg-secondary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">Success Stories</h2>
      <p class="text-xl text-text-secondary max-w-2xl mx-auto">
        Real transformations from real members
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {successStories.map((story) => (
        <div class="bg-bg-primary rounded-xl border border-border-primary hover:border-border-accent transition-all overflow-hidden">
          <div class="grid grid-cols-2 gap-2 p-2">
            <div class="relative aspect-3/4 rounded-lg overflow-hidden">
              <Image
                src={story.beforeImage}
                alt={`${story.name} before`}
                width={400}
                height={600}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute bottom-2 left-2 bg-red-500/90 text-text-primary text-xs px-2 py-1 rounded font-bold">
                Before
              </div>
            </div>
            <div class="relative aspect-3/4 rounded-lg overflow-hidden">
              <Image
                src={story.afterImage}
                alt={`${story.name} after`}
                width={400}
                height={600}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute bottom-2 left-2 bg-green-500/90 text-text-primary text-xs px-2 py-1 rounded font-bold">
                After
              </div>
            </div>
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="text-xl font-bold text-text-primary">{story.name}</h3>
                <p class="text-sm text-text-tertiary">{story.age} years old • {story.duration}</p>
              </div>
              <div class="bg-primary/10 text-primary px-4 py-2 rounded-lg font-bold text-sm">
                {story.result}
              </div>
            </div>
            <p class="text-text-secondary leading-relaxed italic">"{story.story}"</p>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <a
        href="/contact"
        class="inline-flex items-center gap-3 bg-primary hover:bg-primary-hover text-bg-primary px-8 py-4 rounded-lg font-bold text-lg transition-all transform hover:scale-105"
      >
        Start Your Journey
        <i class="ri-arrow-right-line"></i>
      </a>
    </div>
  </div>
</section>


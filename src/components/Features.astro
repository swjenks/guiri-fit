---
import type { Locale } from "../i18n/config";
import { localizedPath } from "../i18n/paths";
import { getSiteContent } from "../data/getSiteContent";

const locale = (Astro.currentLocale ?? "en") as Locale;
const {
  classes,
  features,
  isServiceComingSoon,
  serviceComingSoonMessage,
  serviceCta,
  pages,
  ui,
} = getSiteContent(locale);
---

<section id="features" class="py-20 bg-bg-secondary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">
        {pages.features.title}
      </h2>
      <p class="text-xl text-text-secondary max-w-2xl mx-auto">
        {pages.features.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        features.map((feature, index) => {
          const service = classes[index];
          const href = service
            ? `${localizedPath(locale, "/services")}#service-${service.slug}`
            : localizedPath(locale, "/services");
          const cta = service
            ? serviceCta(service.slug, "home")
            : serviceCta("", "home");
          const comingSoon = service
            ? isServiceComingSoon(service.slug)
            : false;

          return (
            <article
              class:list={[
                "group card-bordered flex flex-col overflow-hidden bg-bg-primary",
                comingSoon
                  ? "service-coming-soon border-border-primary/80"
                  : "card-interactive",
              ]}
            >
              {comingSoon && (
                <div class="service-coming-soon__overlay">
                  <p class="service-coming-soon__label">
                    {serviceComingSoonMessage}
                  </p>
                </div>
              )}
              <div class="relative aspect-video overflow-hidden">
                <img
                  src={feature.image}
                  alt={feature.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                  loading="lazy"
                />
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-2xl font-bold text-text-primary mb-3">
                  {feature.title}
                </h3>
                <p class="text-text-tertiary mb-6 flex-1 leading-relaxed">
                  {feature.description}
                </p>
                {!comingSoon && (
                  <div class="mt-auto flex items-center justify-between gap-4">
                    <a
                      href={href}
                      class="text-primary hover:text-primary-light font-semibold"
                    >
                      {ui.more}
                    </a>
                    <a
                      href={cta.href}
                      class="text-primary hover:text-primary-light font-semibold inline-flex items-center gap-2 text-right"
                      {...(cta.external
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                    >
                      {cta.label}
                      <i
                        class={
                          service?.slug === "community"
                            ? "ri-whatsapp-line"
                            : "ri-arrow-right-line"
                        }
                        aria-hidden="true"
                      />
                    </a>
                  </div>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

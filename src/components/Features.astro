---
import { features } from "../data/siteData";
---

<section id="features" class="py-20 bg-bg-secondary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">
        What I Offer
      </h2>
      <p class="text-xl text-text-secondary max-w-2xl mx-auto">
        Whatever your fitness goals, I've got you covered
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        features.map((feature) => (
          <div class="bg-bg-primary p-8 rounded-xl border border-border-primary hover:border-border-accent transition-all transform hover:scale-105">
            <div class="w-16 h-16 bg-primary/10 rounded-lg flex items-center justify-center mb-6">
              <i class={`${feature.icon} text-4xl text-primary`} />
            </div>
            <h3 class="text-xl font-bold text-text-primary mb-3">
              {feature.title}
            </h3>
            <p class="text-text-tertiary leading-relaxed">
              {feature.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

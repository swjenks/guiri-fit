---
import {
  classes,
  features,
  isServiceComingSoon,
  serviceComingSoonMessage,
  serviceCta,
} from "../data/siteData";

/** Match home “What I Offer” cards to Services page entries */
function featureClassName(title: string) {
  return title.replace(/ \(Seasonal\)/, "");
}

const classByName = new Map(classes.map((item) => [item.name, item]));
---

<section id="features" class="py-20 bg-bg-secondary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">
        What I Offer
      </h2>
      <p class="text-xl text-text-secondary max-w-2xl mx-auto">
        Whatever your fitness goals, I've got you covered
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        features.map((feature) => {
          const service = classByName.get(featureClassName(feature.title));
          const href = service ? `/services#service-${service.slug}` : "/services";
          const cta = service ? serviceCta(service.slug, "home") : serviceCta("", "home");
          const comingSoon = service ? isServiceComingSoon(service.slug) : false;

          return (
            <article
              class:list={[
                "group flex flex-col overflow-hidden rounded-xl border border-border-primary bg-bg-primary",
                comingSoon
                  ? "service-coming-soon border-border-primary/80"
                  : "card-interactive",
              ]}
            >
              {comingSoon && (
                <div class="service-coming-soon__overlay">
                  <p class="service-coming-soon__label">
                    {serviceComingSoonMessage}
                  </p>
                </div>
              )}
              <div
                class:list={[
                  "relative flex flex-1 flex-col",
                  comingSoon && "service-coming-soon__content",
                ]}
              >
              <div class="relative h-64 overflow-hidden">
                <img
                  src={feature.image}
                  alt={feature.title}
                  width={800}
                  height={600}
                  class:list={[
                    "w-full h-full object-cover transition-transform duration-500",
                    !comingSoon && "group-hover:scale-110",
                  ]}
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-linear-to-t from-bg-primary/80 to-transparent" />
                <div class="absolute bottom-4 left-4 right-4">
                  <h3 class="text-xl font-bold text-text-primary mb-2">
                    {feature.title}
                  </h3>
                </div>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <p class="text-text-tertiary leading-relaxed mb-6">
                  {feature.description}
                </p>
                {!comingSoon && (
                  <div class="mt-auto flex items-center justify-between gap-4">
                    <a
                      href={href}
                      class="text-primary hover:text-primary-light font-semibold"
                    >
                      More
                    </a>
                    <a
                      href={cta.href}
                      class="text-primary hover:text-primary-light font-semibold inline-flex items-center gap-2 text-right"
                      {...(cta.external
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                    >
                      {cta.label}
                      <i
                        class={
                          service?.slug === "community"
                            ? "ri-whatsapp-line"
                            : "ri-arrow-right-line"
                        }
                        aria-hidden="true"
                      />
                    </a>
                  </div>
                )}
              </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

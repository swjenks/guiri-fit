---
import SocialLinks from "./SocialLinks.astro";
import BrandName from "./BrandName.astro";
import type { Locale } from "../i18n/config";
import { localizedPath } from "../i18n/paths";
import { getSiteContent } from "../data/getSiteContent";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { siteData, navigation, contactInfo, ui } = getSiteContent(locale);

const footerQuickLinks = [
  { name: ui.footerHome, href: "/" },
  ...navigation,
];
---

<footer class="bg-bg-primary border-t border-border-primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- About Section -->
      <div class="lg:col-span-2">
        <h3 class="text-text-primary mb-4">
          <BrandName />
        </h3>
        <p class="text-text-tertiary mb-4">{siteData.description}</p>
        <SocialLinks variant="footer" />
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-lg font-semibold text-text-primary mb-4">
          {ui.footerQuickLinks}
        </h4>
        <ul class="space-y-2">
          {
            footerQuickLinks.map((item) => (
              <li>
                <a
                  href={localizedPath(locale, item.href)}
                  class="text-text-tertiary hover:text-primary transition-colors"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="text-lg font-semibold text-text-primary mb-4">
          {ui.footerContact}
        </h4>
        <ul class="space-y-4 text-text-tertiary">
          {
            contactInfo.slice(0, 3).map((info) => (
              <li class="flex items-center gap-3">
                <i
                  class={`${info.icon} text-primary text-xl shrink-0 leading-none`}
                  aria-hidden="true"
                />
                {info.link ? (
                  <a
                    href={info.link}
                    class="min-w-0 hover:text-primary transition-colors leading-normal"
                  >
                    {info.content}
                  </a>
                ) : (
                  <span class="min-w-0 leading-normal">{info.content}</span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="border-t border-border-primary mt-8 pt-8 text-center text-text-tertiary"
    >
      <p>
        &copy;{" "}
        <span data-copyright-year>{new Date().getFullYear()}</span>{" "}
        {siteData.name}. {ui.footerRights}
      </p>
    </div>
  </div>
</footer>

<script is:inline>
  document.querySelectorAll("[data-copyright-year]").forEach((el) => {
    el.textContent = String(new Date().getFullYear());
  });
</script>

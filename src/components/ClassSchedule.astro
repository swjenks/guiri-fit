---
import ScheduleCalendar from "./ScheduleCalendar.astro";
import { classSchedule, fullSchedule, siteData } from "../data/siteData";

const previewDays = [
  { label: "Mon – Fri", slots: classSchedule },
  { label: "Sat", slots: fullSchedule.saturday },
];
---

<section id="schedule" class="py-20 bg-bg-primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">
        Training Schedule
      </h2>
      <p class="text-xl text-text-secondary max-w-2xl mx-auto">
        Lock in the days and times that work for you
      </p>
    </div>

    <div class="max-w-5xl mx-auto">
      <ScheduleCalendar days={previewDays} brandName={siteData.name} />

      <div class="text-center mt-8">
        <p class="text-text-tertiary mb-4">View the complete schedule</p>
        <a
          href="/classes"
          class="inline-flex items-center gap-3 bg-primary hover:bg-primary-hover text-bg-primary px-8 py-4 rounded-lg font-bold text-lg transition-all transform hover:scale-105"
        >
          Full Schedule
          <i class="ri-calendar-line"></i>
        </a>
      </div>
    </div>
  </div>
</section>

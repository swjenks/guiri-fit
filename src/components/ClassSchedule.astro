---
import { classSchedule, siteData } from "../data/siteData";
---

<section id="schedule" class="py-20 bg-bg-primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">
        Training Schedule
      </h2>
      <p class="text-xl text-text-secondary max-w-2xl mx-auto">
        Lock in the days and times that work for you
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div
        class="bg-bg-secondary rounded-xl border border-border-primary overflow-hidden"
      >
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-bg-primary">
              <tr>
                <th
                  class="px-6 py-4 text-left text-sm font-bold text-text-primary uppercase tracking-wider"
                  >Time</th
                >
                <th
                  class="px-6 py-4 text-left text-sm font-bold text-text-primary uppercase tracking-wider"
                  >Class</th
                >
                <th
                  class="px-6 py-4 text-left text-sm font-bold text-text-primary uppercase tracking-wider"
                  >Type</th
                >
                <th
                  class="px-6 py-4 text-left text-sm font-bold text-text-primary uppercase tracking-wider"
                  >Action</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-border-primary">
              {
                classSchedule.map((schedule) => (
                  <tr class="hover:bg-bg-tertiary/50 transition-colors">
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="flex items-center gap-2">
                        <i class="ri-time-line text-primary" />
                        <span class="text-text-primary font-semibold">
                          {schedule.time}
                        </span>
                      </div>
                    </td>
                    <td class="px-6 py-4">
                      <span
                        class:list={[
                          "font-medium",
                          schedule.class === siteData.name
                            ? "text-primary"
                            : "text-text-primary",
                        ]}
                      >
                        {schedule.class}
                      </span>
                    </td>
                    <td class="px-6 py-4">
                      <span class="text-text-tertiary">{schedule.type}</span>
                    </td>
                    <td class="px-6 py-4">
                      <a
                        href="/contact"
                        class="text-primary hover:text-primary-light font-semibold flex items-center gap-2"
                      >
                        Book
                        <i class="ri-arrow-right-line" />
                      </a>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div class="text-center mt-8">
        <p class="text-text-tertiary mb-4">View the complete schedule</p>
        <a
          href="/classes"
          class="inline-flex items-center gap-3 bg-primary hover:bg-primary-hover text-bg-primary px-8 py-4 rounded-lg font-bold text-lg transition-all transform hover:scale-105"
        >
          Full Schedule
          <i class="ri-calendar-line"></i>
        </a>
      </div>
    </div>
  </div>
</section>

---
import { Image } from "astro:assets";
import { siteData } from "@data/siteData";
import HeroImage from "@assets/photo-1534438327276-14e5300c3a48.jpg";
import BrandName from "./BrandName.astro";

const taglineClean = siteData.tagline.replace(/[,!]/g, "").trim();
const taglineSegments = taglineClean.split(/\s+(?=get\s)/i);
const taglineLine1 = taglineSegments[0] ?? "";
const taglineLine2 = taglineSegments[1] ?? "";
const taglineClosing = taglineSegments[2] ?? "";
const taglineClosingMatch = taglineClosing.match(/^(get\s+)(GuiriFit)$/i);
---

<section
  class="relative flex min-h-screen items-center justify-center overflow-hidden pt-20"
>
  <!-- Background media (swap <Image /> for <video> when ready) -->
  <div class="absolute inset-0" aria-hidden="true">
    <Image
      src={HeroImage}
      alt=""
      width={1920}
      height={1080}
      class="h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div
    class="absolute inset-0 bg-bg-primary/80"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h1
        class="hero-tagline font-bold text-text-primary mb-6 flex flex-col items-center w-full"
      >
        {
          taglineLine1 && (
            <span class="hero-tagline-line whitespace-nowrap">
              {taglineLine1}
            </span>
          )
        }
        {
          taglineLine2 && (
            <span class="hero-tagline-line whitespace-nowrap">
              {taglineLine2}
            </span>
          )
        }
        {
          taglineClosingMatch ? (
            <span class="hero-tagline-line whitespace-nowrap">
              {taglineClosingMatch[1]}
              <BrandName class="hero-tagline-brand text-primary" />
            </span>
          ) : (
            taglineClosing && (
              <span class="hero-tagline-line whitespace-nowrap">
                {taglineClosing}
              </span>
            )
          )
        }
      </h1>
      <p class="text-xl md:text-2xl text-text-secondary mb-8 leading-relaxed">
        {siteData.description}
      </p>
      <div
        class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center"
      >
        <a
          href="/contact"
          class="bg-primary hover:bg-primary-hover text-bg-primary px-8 py-4 rounded-lg font-bold text-lg transition-all transform inline-flex items-center justify-center gap-3"
        >
          Start Your Journey
          <i class="ri-arrow-right-line"></i>
        </a>
        <a
          href="/about"
          class="bg-transparent border-2 border-text-primary text-text-primary hover:bg-text-primary hover:text-bg-primary px-8 py-4 rounded-lg font-bold text-lg transition-all inline-flex items-center justify-center gap-3"
        >
          Learn More
          <i class="ri-information-line"></i>
        </a>
      </div>
    </div>
  </div>

  <div
    class="absolute bottom-8 left-1/2 z-10 hidden -translate-x-1/2 animate-bounce lg:block"
  >
    <i class="ri-arrow-down-line text-2xl text-text-primary"></i>
  </div>
</section>

<script>
  import "../scripts/fit-hero-tagline.ts";
</script>

---
import { Image } from "astro:assets";
import HeroBackgroundImage from "@assets/photo-1534438327276-14e5300c3a48.jpg";
import HeroForegroundImage from "@assets/shawn.jpeg";
import BrandName from "./BrandName.astro";
import type { Locale } from "../i18n/config";
import { localizedPath } from "../i18n/paths";
import { getSiteContent } from "../data/getSiteContent";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { siteData, ui, pages, contactHref } = getSiteContent(locale);
const heroLines = pages.home.heroLines;
---

<section
  class="relative flex min-h-screen items-center justify-center overflow-hidden pt-20"
>
  <!-- Full-bleed background (swap for <video> when ready) -->
  <div class="absolute inset-0" aria-hidden="true">
    <Image
      src={HeroBackgroundImage}
      alt=""
      width={1920}
      height={1080}
      class="h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="absolute inset-0 bg-bg-primary/80" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <!-- Text content -->
      <div class="text-center lg:text-left">
        <h1 class="hero-tagline mb-6 font-bold text-text-primary">
          {
            heroLines.map((line) => (
              <span class="hero-tagline-line whitespace-nowrap">
                {line.text}
                {"suffixBrand" in line && line.suffixBrand ? (
                  <BrandName class="hero-tagline-brand text-primary" />
                ) : null}
              </span>
            ))
          }
        </h1>
        <p
          class="hero-tagline-follow text-xl md:text-2xl text-text-secondary mb-8 leading-relaxed"
        >
          {siteData.description}
        </p>
        <div
          class="hero-tagline-follow flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center lg:justify-start"
        >
          <a
            href={contactHref}
            class="bg-primary hover:bg-primary-hover text-bg-primary px-8 py-4 rounded-lg font-bold text-lg transition-all transform inline-flex items-center justify-center gap-3"
          >
            {ui.startYourJourney}
            <i class="ri-arrow-right-line"></i>
          </a>
          <a
            href={localizedPath(locale, "/about")}
            class="bg-transparent border-2 border-text-primary text-text-primary hover:bg-text-primary hover:text-bg-primary px-8 py-4 rounded-lg font-bold text-lg transition-all inline-flex items-center justify-center"
          >
            {ui.aboutMe}
          </a>
        </div>
      </div>

      <!-- Foreground hero image with parallelogram name banner -->
      <div class="hidden lg:block px-3 py-2">
        <div
          class="group hero-profile-parallelogram card-interactive relative mx-auto w-full max-w-md -skew-x-10 overflow-hidden rounded-xl border border-border-primary bg-bg-secondary shadow-2xl"
        >
          <div class="absolute inset-0 skew-x-10 origin-center scale-[1.14]">
            <Image
              src={HeroForegroundImage}
              alt={`Fitness training with ${siteData.name}`}
              width={800}
              height={1000}
              class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-110"
              loading="eager"
            />
          </div>
          <div class="absolute inset-x-0 bottom-0 z-10 p-5 sm:p-6">
            <div
              class="hero-profile-banner rounded-lg bg-primary px-3 py-3 text-center"
            >
              <div class="skew-x-10">
                <h3 class="text-sm font-bold leading-tight text-bg-primary sm:text-base">
                  {ui.heroCoachName}
                </h3>
                <p
                  class="mt-0.5 text-sm font-medium leading-tight text-bg-primary/85 sm:text-base"
                >
                  {ui.heroCoachRole}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    class="absolute bottom-8 left-1/2 z-10 hidden -translate-x-1/2 animate-bounce lg:block"
  >
    <i class="ri-arrow-down-line text-2xl text-text-primary"></i>
  </div>
</section>

<script>
  import "../scripts/fit-hero-tagline.ts";
</script>

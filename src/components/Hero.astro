---
import { Image } from "astro:assets";
import { siteData } from "@data/siteData";
import HeroImage from "@assets/photo-1534438327276-14e5300c3a48.jpg";
import BrandName from "./BrandName.astro";

const taglineClean = siteData.tagline.replace(/[,!]/g, "").trim();
const taglineSegments = taglineClean.split(/\s+(?=get\s)/i);
const taglineLine1 = taglineSegments[0] ?? "";
const taglineLine2 = taglineSegments[1] ?? "";
const taglineClosing = taglineSegments[2] ?? "";
const taglineClosingMatch = taglineClosing.match(/^(get\s+)(GuiriFit)$/i);
---

<section
  class="relative min-h-screen flex items-center justify-center bg-linear-to-br from-bg-primary via-bg-secondary to-bg-primary pt-20 overflow-hidden"
>
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div
      class="absolute inset-0"
      style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"
    >
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Text Content -->
      <div class="text-center lg:text-left">
        <h1
          class="hero-tagline font-bold text-text-primary mb-6 flex flex-col items-center lg:items-start w-full"
        >
          {
            taglineLine1 && (
              <span class="hero-tagline-line whitespace-nowrap">
                {taglineLine1}
              </span>
            )
          }
          {
            taglineLine2 && (
              <span class="hero-tagline-line whitespace-nowrap">
                {taglineLine2}
              </span>
            )
          }
          {
            taglineClosingMatch ? (
              <span class="hero-tagline-line whitespace-nowrap">
                {taglineClosingMatch[1]}
                <BrandName class="hero-tagline-brand text-primary" />
              </span>
            ) : (
              taglineClosing && (
                <span class="hero-tagline-line whitespace-nowrap">
                  {taglineClosing}
                </span>
              )
            )
          }
        </h1>
        <p class="text-xl md:text-2xl text-text-secondary mb-8 leading-relaxed">
          {siteData.description}
        </p>
        <div
          class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center lg:justify-start"
        >
          <a
            href="/contact"
            class="bg-primary hover:bg-primary-hover text-bg-primary px-8 py-4 rounded-lg font-bold text-lg transition-all transform inline-flex items-center justify-center gap-3"
          >
            Start Your Journey
            <i class="ri-arrow-right-line"></i>
          </a>
          <a
            href="/about"
            class="bg-transparent border-2 border-text-primary text-text-primary hover:bg-text-primary hover:text-bg-primary px-8 py-4 rounded-lg font-bold text-lg transition-all inline-flex items-center justify-center gap-3"
          >
            Learn More
            <i class="ri-information-line"></i>
          </a>
        </div>
      </div>

      <!-- Hero Image -->
      <div class="hidden lg:block">
        <div class="relative">
          <div
            class="aspect-square rounded-2xl overflow-hidden bg-bg-secondary border-2 border-border-primary shadow-2xl"
          >
            <Image
              src={HeroImage}
              alt="Fitness training"
              width={800}
              height={800}
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
          <div
            class="absolute -bottom-6 -left-6 bg-primary p-6 rounded-xl shadow-xl"
          >
            <div class="flex items-center gap-3">
              <div
                class="w-12 h-12 bg-bg-primary rounded-lg flex items-center justify-center"
              >
                <i class="ri-trophy-line text-2xl text-primary"></i>
              </div>
              <div>
                <div class="text-bg-primary font-bold text-lg">
                  Shawn Jenkins
                </div>
                <div class="text-bg-primary/80 text-sm">Your Guiri Coach</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div
    class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce hidden lg:block"
  >
    <i class="ri-arrow-down-line text-2xl text-text-primary"></i>
  </div>
</section>

<script>
  import "../scripts/fit-hero-tagline.ts";
</script>

---
import { classes } from '../data/siteData';
---

<section id="classes" class="py-20 bg-bg-primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">Our Classes</h2>
      <p class="text-xl text-text-secondary max-w-2xl mx-auto">
        Find the perfect workout for your fitness level and goals
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {classes.map((classItem) => (
        <div class="bg-bg-secondary p-8 rounded-xl border border-border-primary hover:border-border-accent transition-all transform hover:scale-105">
          <div class="flex justify-between items-start mb-6">
            <h3 class="text-xl font-bold text-text-primary">{classItem.name}</h3>
            <span class="bg-primary text-bg-primary text-xs px-3 py-1 rounded-full font-semibold whitespace-nowrap">
              {classItem.difficulty}
            </span>
          </div>
          <p class="text-text-tertiary mb-6 leading-relaxed">{classItem.description}</p>
          <div class="flex items-center justify-between">
            <div class="flex items-center text-text-muted gap-2">
              <i class="ri-time-line text-primary"></i>
              <span>{classItem.duration}</span>
            </div>
            <a
              href="/contact"
              class="text-primary hover:text-primary-light font-semibold flex items-center gap-2"
            >
              Book Now
              <i class="ri-arrow-right-line"></i>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-16">
      <a
        href="/classes"
        class="inline-flex items-center gap-3 bg-primary hover:bg-primary-hover text-bg-primary px-8 py-4 rounded-lg font-bold text-lg transition-all transform hover:scale-105"
      >
        View All Classes
        <i class="ri-arrow-right-line"></i>
      </a>
    </div>
  </div>
</section>


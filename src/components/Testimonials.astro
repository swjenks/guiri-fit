---
import { testimonials } from '../data/siteData';
---

<section id="testimonials" class="py-20 bg-bg-primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">What Our Members Say</h2>
      <p class="text-xl text-text-secondary max-w-2xl mx-auto">
        Real stories from real people achieving their fitness goals
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {testimonials.map((testimonial) => (
        <div class="bg-bg-secondary p-8 rounded-xl border border-border-primary hover:border-border-accent transition-all">
          <div class="flex mb-6 gap-1">
            {Array.from({ length: testimonial.rating }).map(() => (
              <i class="ri-star-fill text-primary text-xl"></i>
            ))}
          </div>
          <p class="text-text-secondary mb-6 italic leading-relaxed">"{testimonial.content}"</p>
          <div class="pt-4 border-t border-border-primary">
            <div class="font-bold text-text-primary mb-1">{testimonial.name}</div>
            <div class="text-sm text-text-tertiary">{testimonial.role}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>


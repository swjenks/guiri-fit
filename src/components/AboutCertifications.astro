---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type {
  CertificationLogoKey,
  TrainerCertificationIssuer,
} from "../data/siteData";

interface Props {
  issuers: TrainerCertificationIssuer[];
  title: string;
  institutionLabel: string;
  certificationLabel: string;
  statusLabel: string;
  certifiedLabel: string;
  inProgressLabel: string;
  logos: Record<CertificationLogoKey, ImageMetadata>;
}

const {
  issuers,
  title,
  institutionLabel,
  certificationLabel,
  statusLabel,
  certifiedLabel,
  inProgressLabel,
  logos,
} = Astro.props;

const rowClass = "site-table__row";

const totalRows = issuers.reduce(
  (sum, issuer) => sum + issuer.certifications.length,
  0,
);

let rowIndex = 0;

const certGroupHoverRules = issuers
  .map(
    (issuer) =>
      `.certifications-table tbody:has(tr[data-cert-group="${issuer.logo}"]:hover) tr[data-cert-group="${issuer.logo}"] td { background-color: var(--color-bg-secondary); }`,
  )
  .join("\n");
---

<section class="py-20 bg-bg-secondary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-4xl font-bold text-text-primary mb-12 text-center">
      {title}
    </h2>

    <div class="max-w-5xl mx-auto min-w-0">
      <div class="site-table-card">
        <table class="site-table site-table--auto certifications-table">
          <thead>
            <tr class="border-b border-border-primary">
              <th class="site-table__col-institution text-left">
                {institutionLabel}
              </th>
              <th class="text-left">{certificationLabel}</th>
              <th class="site-table__col-fit text-left">{statusLabel}</th>
            </tr>
          </thead>
          <tbody>
            {
              issuers.flatMap((issuer) =>
                issuer.certifications.map((cert, certIndex) => {
                  const isFirstInGroup = certIndex === 0;
                  const groupSize = issuer.certifications.length;
                  const isLastRow = ++rowIndex === totalRows;

                  return (
                    <tr
                      data-cert-group={issuer.logo}
                      class:list={[
                        rowClass,
                        !isLastRow ? "border-b border-border-primary/50" : "",
                      ]}
                    >
                      {isFirstInGroup ? (
                        <td
                          rowspan={groupSize}
                          data-cert-group={issuer.logo}
                          class="site-table__institution-cell site-table__institution-cell--merged"
                        >
                          <div class="site-table__institution-merged-inner">
                            <span class="site-table__institution-acronym">
                              {issuer.institutionShort}
                            </span>
                            <span class="hidden md:block">
                              <span class="cert-institution-logo">
                                <Image
                                  src={logos[issuer.logo]}
                                  alt={issuer.institute}
                                  width={158}
                                  height={32}
                                  class="cert-institution-logo__img"
                                />
                              </span>
                            </span>
                            <span class="sr-only md:hidden">
                              {issuer.institute}
                            </span>
                          </div>
                        </td>
                      ) : null}
                      <td class="site-table__fill-cell">{cert.name}</td>
                      <td class="site-table__status-cell">
                        {cert.inProgress ? (
                          <span class="cert-status-badge cert-status-badge--progress">
                            {inProgressLabel}
                          </span>
                        ) : (
                          <span class="cert-status-badge cert-status-badge--certified">
                            {certifiedLabel}
                          </span>
                        )}
                      </td>
                    </tr>
                  );
                }),
              )
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style is:global set:html={certGroupHoverRules} />

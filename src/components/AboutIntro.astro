---
import { siteData } from "../data/siteData";
---

<section class="py-20 bg-bg-primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
        What is {siteData.name}?
      </h2>
      <p class="text-xl text-text-secondary">
        GuiriFit is a community-focused fitness coaching service located in
        Granada that offers HIIT-style group classes and personalized training
        programs to help you achieve your fitness goals.
      </p>
    </div>
  </div>
</section>

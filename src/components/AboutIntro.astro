---
import type { Locale } from "../i18n/config";
import { getSiteContent } from "../data/getSiteContent";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { pages } = getSiteContent(locale);
const intro = pages.home.aboutIntro;
---

<section class="py-20 bg-bg-primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
        {intro.title}
      </h2>
      <p class="text-xl text-text-secondary">{intro.lead}</p>
    </div>

    <div class="grid w-full grid-cols-1 gap-8 md:grid-cols-3">
      {
        intro.cards.map((point, index) => (
          <div class="card-bordered card-interactive flex h-full min-w-0 flex-col bg-bg-secondary p-8 text-center">
            <div class="w-20 h-20 bg-primary/10 rounded-lg flex items-center justify-center mx-auto mb-6">
              <i
                class={`${(["ri-run-line", "ri-heart-pulse-line", "ri-dna-line"] as const)[index] ?? "ri-run-line"} text-4xl text-primary`}
              />
            </div>
            <h3 class="text-2xl font-bold text-text-primary mb-3">
              {point.title}
            </h3>
            <p class="text-text-tertiary leading-relaxed flex-1">
              {point.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

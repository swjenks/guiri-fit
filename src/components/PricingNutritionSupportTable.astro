---
import type { Locale } from "../i18n/config";
import { getSiteContent } from "../data/getSiteContent";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { nutritionSupportPackages, pricingSectionCopy, ui, contactHref } =
  getSiteContent(locale);
const table = ui.pricingTable;
const { subtitle, footnote, disclaimer, rows } = nutritionSupportPackages;

const rowBorder = (index: number, length: number) =>
  index < length - 1 ? "border-b border-border-primary/50" : "";
---

<div class="max-w-6xl mx-auto mb-16">
  <div class="text-center mb-10">
    <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-3">
      {pricingSectionCopy.nutrition.title}
    </h2>
    <p class="text-lg md:text-xl text-text-secondary">{subtitle}</p>
  </div>

  <div class="flex flex-col gap-8">
    <div class="min-w-0">
      <div
        class="site-table-card min-w-0 overflow-x-auto"
      >
        <table class="site-table site-table--auto site-table--cells-top min-w-[520px]">
          <thead>
            <tr class="border-b border-border-primary">
              <th class="text-left">{table.service}</th>
              <th class="text-left">{table.whatsIncluded}</th>
              <th class="site-table__price-col">{table.price}</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row, index) => (
                <tr
                  class:list={[
                    "site-table__row",
                    rowBorder(index, rows.length),
                  ]}
                >
                  <td class="site-table__service-col">{row.service}</td>
                  <td class="site-table__included-col">
                    {row.whatsIncluded}
                  </td>
                  <td class="site-table__price-col">
                    <span class="site-table__total-value">
                      {row.price}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="mt-4 text-sm text-text-tertiary leading-relaxed">{footnote}</p>

      <p
        class="mt-4 text-xs text-text-tertiary leading-relaxed border border-border-primary/60 rounded-lg bg-bg-secondary/40 p-4 sm:p-5"
      >
        {disclaimer}
      </p>
    </div>

    <div class="flex justify-center">
      <a
        href={contactHref}
        class="inline-flex min-w-56 items-center justify-center gap-3 rounded-lg bg-primary px-8 py-4 text-lg font-bold text-bg-primary transition-all hover:bg-primary-hover"
      >
        {ui.getStarted}
        <i class="ri-arrow-right-line" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</div>

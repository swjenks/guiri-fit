---
import Layout from "../layouts/Layout.astro";
import { classes, siteData } from "@data/siteData";
---

<Layout
  title={`Services - ${siteData.name}`}
  description="Personal training, group classes, and fitness services in Granada"
>
  <section class="pt-32 pb-20 bg-bg-secondary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
          Services
        </h1>
        <p class="text-xl text-text-secondary">
          Find the perfect workout for your fitness level and goals—explore our
          training options and book the session that fits you.
        </p>
      </div>

      <div class="space-y-16">
        {
          classes.map((classItem) => (
            <div class="bg-bg-primary rounded-xl border border-border-primary overflow-hidden">
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
                <div class="relative h-64 lg:h-auto">
                  <img
                    src={classItem.image}
                    alt={classItem.name}
                    width={800}
                    height={600}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute top-4 right-4">
                    <span class="bg-primary text-bg-primary text-sm px-4 py-2 rounded-full font-semibold">
                      {classItem.difficulty}
                    </span>
                  </div>
                </div>

                <div class="p-8">
                  <div class="flex items-center justify-between mb-4">
                    <h2 class="text-3xl font-bold text-text-primary">
                      {classItem.name}
                    </h2>
                    <div class="flex items-center text-text-tertiary gap-2">
                      <i class="ri-time-line text-primary" />
                      <span>{classItem.duration}</span>
                    </div>
                  </div>

                  <p class="text-text-secondary text-lg mb-4 leading-relaxed">
                    {classItem.detailedDescription}
                  </p>

                  <div class="mb-6">
                    <p class="text-text-primary font-semibold mb-2">
                      Trainer:{" "}
                      <span class="text-primary">{classItem.trainer}</span>
                    </p>
                    <p class="text-text-tertiary text-sm">
                      What to expect: {classItem.whatToExpect}
                    </p>
                  </div>

                  <div class="mb-6">
                    <h3 class="text-text-primary font-semibold mb-3">
                      Key Benefits:
                    </h3>
                    <ul class="grid grid-cols-2 gap-2">
                      {classItem.benefits.map((benefit) => (
                        <li class="flex items-center gap-2 text-text-secondary text-sm">
                          <i class="ri-checkbox-circle-fill text-primary" />
                          {benefit}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <a
                    href="/contact"
                    class="inline-flex items-center gap-2 bg-primary hover:bg-primary-hover text-bg-primary px-6 py-3 rounded-lg font-semibold transition-all"
                  >
                    Book This Class
                    <i class="ri-arrow-right-line" />
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

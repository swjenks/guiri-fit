---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import ScheduleSeasonInit from "../components/ScheduleSeasonInit.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { siteData, contactInfo } from "../data/siteData";
import { getContactHoursLines } from "../utils/contactHours";
import MapImage from "@assets/photo-1517487881594-2787fef5ebf7.jpg";

const springFallContactHours = getContactHoursLines("spring-fall");
const summerWinterContactHours = getContactHoursLines("summer-winter");
---

<Layout
  title={`Contact Me - ${siteData.name}`}
  description="Get in touch with us to start your fitness journey"
>
  <ScheduleSeasonInit />
  <!-- Hero Section -->
  <section
    class="pt-32 pb-20 bg-linear-to-br from-bg-primary via-bg-secondary to-bg-primary"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
          Contact Me
        </h1>
        <p class="text-xl text-text-secondary">
          We're here to help you on your fitness journey. Get in touch today!
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Info & Form -->
  <section class="py-20 bg-bg-secondary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
        <!-- Contact Information -->
        <div>
          <h2 class="text-3xl font-bold text-text-primary mb-8">
            Get In Touch
          </h2>
          <div class="space-y-6">
            {
              contactInfo.map((info) => (
                <div class="flex items-start gap-4">
                  <div class="bg-primary p-4 rounded-lg shrink-0">
                    <i class={`${info.icon} text-2xl text-bg-primary`} />
                  </div>
                  <div>
                    <h3 class="text-xl font-semibold text-text-primary mb-2">
                      {info.title}
                    </h3>
                    {Array.isArray(info.content) ? (
                      info.content.map((line) => (
                        <p class="text-text-tertiary leading-relaxed">{line}</p>
                      ))
                    ) : info.link ? (
                      <a
                        href={info.link}
                        class="text-text-tertiary hover:text-primary transition-colors"
                      >
                        {info.content}
                      </a>
                    ) : (
                      <p class="text-text-tertiary leading-relaxed">
                        {info.content}
                      </p>
                    )}
                  </div>
                </div>
              ))
            }

            <div class="flex items-start gap-4">
              <div class="bg-primary p-4 rounded-lg shrink-0">
                <i class="ri-time-line text-2xl text-bg-primary"></i>
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="text-xl font-semibold text-text-primary mb-2">
                  Hours
                </h3>
                <div
                  class="contact-hours-season space-y-1"
                  data-season="spring-fall"
                >
                  {
                    springFallContactHours.map((line, index) => (
                      <p
                        class:list={[
                          "leading-relaxed",
                          index === 0
                            ? "text-text-secondary font-medium"
                            : "text-text-tertiary",
                        ]}
                      >
                        {line}
                      </p>
                    ))
                  }
                  <p class="text-text-tertiary leading-relaxed">
                    Times shown in CET. See the full calendar{" "}
                    <a
                      href="/hours"
                      class="text-primary hover:text-primary-hover underline underline-offset-2"
                    >
                      here
                    </a>
                    .
                  </p>
                </div>
                <div
                  class="contact-hours-season space-y-1"
                  data-season="summer-winter"
                >
                  {
                    summerWinterContactHours.map((line, index) => (
                      <p
                        class:list={[
                          "leading-relaxed",
                          index === 0
                            ? "text-text-secondary font-medium"
                            : "text-text-tertiary",
                        ]}
                      >
                        {line}
                      </p>
                    ))
                  }
                  <p class="text-text-tertiary leading-relaxed">
                    Times shown in CET. See the full calendar{" "}
                    <a
                      href="/hours"
                      class="text-primary hover:text-primary-hover underline underline-offset-2"
                    >
                      here
                    </a>
                    .
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Social Links -->
          <div class="mt-10">
            <h3 class="text-xl font-semibold text-text-primary mb-4">
              Follow Us
            </h3>
            <SocialLinks variant="contact" />
          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <!-- Response Time Section -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="bg-bg-primary p-8 rounded-xl border border-border-primary">
          <div class="flex items-start gap-6">
            <div class="bg-primary/10 p-4 rounded-lg shrink-0">
              <i class="ri-time-line text-4xl text-primary"></i>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-text-primary mb-3">
                Response Time
              </h3>
              <p class="text-text-secondary mb-4 leading-relaxed">
                We're committed to getting back to you quickly. Here's what you
                can expect:
              </p>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <i class="ri-checkbox-circle-fill text-primary text-xl mt-0.5"
                  ></i>
                  <div>
                    <span class="text-text-primary font-semibold"
                      >Email inquiries:</span
                    >
                    <span class="text-text-secondary">
                      We respond within 24 hours during business days</span
                    >
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <i class="ri-checkbox-circle-fill text-primary text-xl mt-0.5"
                  ></i>
                  <div>
                    <span class="text-text-primary font-semibold"
                      >WhatsApp:</span
                    >
                    <span class="text-text-secondary">
                      We typically reply within a few hours during business days</span
                    >
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <i class="ri-checkbox-circle-fill text-primary text-xl mt-0.5"
                  ></i>
                  <div>
                    <span class="text-text-primary font-semibold"
                      >Form submissions:</span
                    >
                    <span class="text-text-secondary">
                      Confirmation within 2 hours, full response within 24 hours</span
                    >
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <i class="ri-checkbox-circle-fill text-primary text-xl mt-0.5"
                  ></i>
                  <div>
                    <span class="text-text-primary font-semibold"
                      >Urgent matters:</span
                    >
                    <span class="text-text-secondary">
                      Call us directly for immediate assistance</span
                    >
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section (Placeholder) -->
  <section class="py-20 bg-bg-secondary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-text-primary mb-12 text-center">
        Find Us
      </h2>
      <div
        class="max-w-5xl mx-auto bg-bg-secondary p-8 rounded-xl border border-border-primary"
      >
        <div
          class="aspect-video bg-bg-tertiary rounded-lg flex items-center justify-center overflow-hidden relative"
        >
          <Image
            src={MapImage}
            alt="Gym location map"
            width={1200}
            height={600}
            class="w-full h-full object-cover opacity-50"
            loading="lazy"
          />
          <div
            class="absolute inset-0 flex items-center justify-center text-center p-4"
          >
            <div>
              <i class="ri-map-pin-line text-5xl text-primary mb-4"></i>
              <p class="text-text-secondary text-lg">
                Map integration can be added here (Google Maps, etc.)
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

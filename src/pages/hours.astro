---
import Layout from "../layouts/Layout.astro";
import ScheduleSeasonBlock from "../components/ScheduleSeasonBlock.astro";
import ScheduleSeasonInit from "../components/ScheduleSeasonInit.astro";
import type { Locale } from "../i18n/config";
import { getScheduleSeasonCopy, getCalendarDayLabels } from "../i18n/schedule";
import { getSiteContent } from "../data/getSiteContent";
import {
  outdoorScheduleDays,
  scheduleDays,
  toCalendarDays,
} from "../utils/classSchedule";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { siteData, pages } = getSiteContent(locale);
const seasonCopy = getScheduleSeasonCopy(locale);
const dayLabels = getCalendarDayLabels(locale);

const springFallDays = toCalendarDays(outdoorScheduleDays, dayLabels);
const summerWinterDays = toCalendarDays(scheduleDays, dayLabels);
const copy = pages.hours;
---

<Layout title={`${copy.heroTitle} - ${siteData.name}`} description={copy.metaDescription}>
  <ScheduleSeasonInit />
  <section class="page-hero-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h1 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
          {copy.heroTitle}
        </h1>
        <p class="text-xl text-text-secondary">{copy.heroSubtitle}</p>
      </div>

      <div class="schedule-season-stack p-4 sm:p-6">
        <ScheduleSeasonBlock
          season="spring-fall"
          title={seasonCopy.springFall.title}
          description={seasonCopy.springFall.description}
          days={springFallDays}
          brandName={siteData.scheduleBrandClass}
        />
        <ScheduleSeasonBlock
          season="summer-winter"
          title={seasonCopy.summerWinter.title}
          description={seasonCopy.summerWinter.description}
          days={summerWinterDays}
          brandName={siteData.scheduleBrandClass}
        />
        <p class="text-text-tertiary text-center mt-2 text-sm order-3">
          {copy.disclaimer}
        </p>
      </div>
    </div>
  </section>
</Layout>

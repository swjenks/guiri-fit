---
import Layout from "../layouts/Layout.astro";
import { classes, siteData } from "@data/siteData";
import ScheduleCalendar from "../components/ScheduleCalendar.astro";
import { scheduleDays } from "../utils/classSchedule";

const calendarDayLabels = [
  "Mon",
  "Tue",
  "Wed",
  "Thu",
  "Fri",
  "Sat",
  "Sun",
];

const calendarDays = scheduleDays.map((slots, index) => ({
  label: calendarDayLabels[index],
  slots,
}));
---

<Layout title={`Classes - ${siteData.name}`} description="Browse our wide range of fitness classes">
  <!-- Hero Section -->
  <section class="pt-32 pb-20 bg-linear-to-br from-bg-primary via-bg-secondary to-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">Our Classes</h1>
        <p class="text-xl text-text-secondary">
          Find the perfect workout for your fitness level and goals
        </p>
      </div>
    </div>
  </section>

  <!-- Detailed Classes Section -->
  <section class="py-20 bg-bg-secondary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-16">
        {classes.map((classItem) => (
          <div class="bg-bg-primary rounded-xl border border-border-primary overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
              <!-- Image -->
              <div class="relative h-64 lg:h-auto">
                <img
                  src={classItem.image}
                  alt={classItem.name}
                  width={800}
                  height={600}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute top-4 right-4">
                  <span class="bg-primary text-bg-primary text-sm px-4 py-2 rounded-full font-semibold">
                    {classItem.difficulty}
                  </span>
                </div>
              </div>
              
              <!-- Content -->
              <div class="p-8">
                <div class="flex items-center justify-between mb-4">
                  <h2 class="text-3xl font-bold text-text-primary">{classItem.name}</h2>
                  <div class="flex items-center text-text-tertiary gap-2">
                    <i class="ri-time-line text-primary"></i>
                    <span>{classItem.duration}</span>
                  </div>
                </div>
                
                <p class="text-text-secondary text-lg mb-4 leading-relaxed">{classItem.detailedDescription}</p>
                
                <div class="mb-6">
                  <p class="text-text-primary font-semibold mb-2">Trainer: <span class="text-primary">{classItem.trainer}</span></p>
                  <p class="text-text-tertiary text-sm">What to expect: {classItem.whatToExpect}</p>
                </div>
                
                <div class="mb-6">
                  <h4 class="text-text-primary font-semibold mb-3">Key Benefits:</h4>
                  <ul class="grid grid-cols-2 gap-2">
                    {classItem.benefits.map((benefit) => (
                      <li class="flex items-center gap-2 text-text-secondary text-sm">
                        <i class="ri-checkbox-circle-fill text-primary"></i>
                        {benefit}
                      </li>
                    ))}
                  </ul>
                </div>
                
                <a
                  href="/contact"
                  class="inline-flex items-center gap-2 bg-primary hover:bg-primary-hover text-bg-primary px-6 py-3 rounded-lg font-semibold transition-all"
                >
                  Book This Class
                  <i class="ri-arrow-right-line"></i>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Full Schedule Section -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-text-primary mb-4 text-center">Full Weekly Schedule</h2>
      <p class="text-xl text-text-secondary mb-12 text-center max-w-2xl mx-auto">
        Plan your week with our complete class schedule
      </p>
      <div class="p-4 sm:p-6">
        <ScheduleCalendar days={calendarDays} brandName={siteData.name} />
        <p class="text-text-tertiary text-center mt-6 text-sm">
          * Schedule may vary. Please contact us for the most up-to-date class times or to book a spot.
        </p>
      </div>
    </div>
  </section>
</Layout>

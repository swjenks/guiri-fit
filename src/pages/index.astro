---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AboutIntro from '../components/AboutIntro.astro';
import Features from '../components/Features.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import { siteData } from '../data/siteData';
---

<Layout title={`${siteData.name} - ${siteData.tagline}`} description={siteData.description}>
  <Hero />
  <AboutIntro />
  <Features />
  <Testimonials />
  <FAQ subtitle="Everything you need to know about GuiriFit" />

  <!-- CTA Section -->
  <section class="section-cta-gradient">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-bg-primary mb-4">
        Ready to start your fitness journey?
      </h2>
      <p class="text-xl text-bg-primary/90 mb-8 max-w-2xl mx-auto">
        Sometimes, all you need is a little nudge to hit this button...
      </p>
      <a
        href="/contact"
        class="btn-interactive inline-flex items-center justify-center gap-3 rounded-lg bg-bg-primary px-8 py-4 text-lg font-bold text-text-primary shadow-lg hover:bg-bg-secondary"
      >
        Start Your Adventure
        <i class="ri-arrow-right-line"></i>
      </a>
    </div>
  </section>
</Layout>

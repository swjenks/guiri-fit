---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CoachPhoto from "@assets/shawn.jpeg";
import eptiLogo from "@assets/cert-logos/epti.png";
import crossfitLogo from "@assets/cert-logos/crossfit.svg";
import nasmLogo from "@assets/cert-logos/nasm.png";
import { siteData, trainers, history } from "../data/siteData";

const coach = trainers[0]!;

const instituteLogos = {
  epti: eptiLogo,
  crossfit: crossfitLogo,
  nasm: nasmLogo,
} as const;

type InstituteLogoKey = keyof typeof instituteLogos;
---

<Layout
  title={`About Me - ${siteData.name}`}
  description="Meet Coach Shawn and learn about the mission behind GuiriFit"
>
  <section
    class="pt-32 pb-20 bg-linear-to-br from-bg-primary via-bg-secondary to-bg-primary"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
          About Me
        </h1>
        <p class="text-xl text-text-secondary">
          Get to know your Guiri Coach
        </p>
      </div>

      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <div
            class="relative mx-auto max-w-md overflow-hidden rounded-2xl border-2 border-border-primary bg-bg-secondary shadow-2xl lg:mx-0"
          >
            <Image
              src={CoachPhoto}
              alt={`${coach.name} - ${coach.role}`}
              width={600}
              height={750}
              class="aspect-[4/5] w-full object-cover"
              loading="eager"
            />
          </div>
        </div>

        <div class="lg:col-span-7">
          <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-3">
            {coach.name}
          </h2>
          <p class="text-xl font-semibold text-primary mb-2">{coach.role}</p>
          <p class="text-text-tertiary mb-4">{coach.specialization}</p>
          <p class="mb-8 inline-flex items-center gap-2 rounded-full border border-border-primary bg-bg-primary/60 px-4 py-2 text-sm text-text-secondary">
            <i class="ri-medal-line text-primary" aria-hidden="true"></i>
            {coach.experience}
          </p>
          <p class="text-lg text-text-secondary leading-relaxed mb-8">
            {coach.bio}
          </p>
          <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
            <div>
              <h2
                class="text-sm font-semibold uppercase tracking-wide text-text-primary mb-4"
              >
                Certifications
              </h2>
              <div
                class="rounded-xl border border-border-primary bg-bg-primary/60 px-5 py-4 h-full"
              >
                <div class="mb-3 flex items-center gap-3">
                  <Image
                    src={
                      instituteLogos[
                        coach.certifications.logo as InstituteLogoKey
                      ]
                    }
                    alt=""
                    width={158}
                    height={32}
                    class="h-8 w-auto max-w-[5.5rem] shrink-0 object-contain object-left"
                  />
                  <p class="min-w-0 text-base font-semibold leading-snug text-text-primary">
                    {coach.certifications.institute}
                  </p>
                </div>
                <ul class="space-y-1.5 pl-1">
                  {
                    coach.certifications.credentials.map((credential) => (
                      <li class="flex items-start gap-2 text-sm text-text-secondary">
                        <span
                          class="mt-2 h-1 w-1 shrink-0 rounded-full bg-primary"
                          aria-hidden="true"
                        />
                        {credential}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>

            <div>
              <h2
                class="text-sm font-semibold uppercase tracking-wide text-text-primary mb-4"
              >
                Next Up
              </h2>
              <div class="flex h-full flex-col gap-4">
                {
                  coach.currentlyStudying.map((program) => (
                    <div class="rounded-xl border border-border-primary bg-bg-primary/60 px-5 py-4">
                      <div class="mb-3 flex items-center gap-3">
                        <Image
                          src={
                            instituteLogos[program.logo as InstituteLogoKey]
                          }
                          alt=""
                          width={158}
                          height={32}
                          class="h-8 w-auto max-w-[5.5rem] shrink-0 object-contain object-left"
                        />
                        <p class="min-w-0 text-base font-semibold leading-snug text-text-primary">
                          {program.institute}
                        </p>
                      </div>
                      <ul class="space-y-1.5 pl-1">
                        {program.credentials.map((credential) => (
                          <li class="flex items-start gap-2 text-sm text-text-secondary">
                            <span
                              class="mt-2 h-1 w-1 shrink-0 rounded-full bg-primary"
                              aria-hidden="true"
                            />
                            {credential}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-bold text-text-primary mb-8 text-center">
          My Mission
        </h2>
        <div class="prose prose-invert max-w-none">
          <p class="text-xl text-text-secondary mb-6">
            At {siteData.name}, we believe that fitness is not just about
            physical strength, but about building confidence, discipline, and a
            positive mindset. Our mission is to create an inclusive community
            where everyone feels welcome and supported on their fitness journey.
          </p>
          <p class="text-lg text-text-tertiary mb-6">
            We provide state-of-the-art facilities, expert guidance, and a
            supportive environment that empowers our members to push their
            limits and achieve extraordinary results.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-text-primary mb-12 text-center">
        My Values
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div
          class="bg-bg-secondary p-8 rounded-xl border border-border-primary text-center hover:border-border-accent transition-all"
        >
          <div
            class="w-20 h-20 bg-primary/10 rounded-lg flex items-center justify-center mx-auto mb-6"
          >
            <i class="ri-trophy-line text-4xl text-primary"></i>
          </div>
          <h3 class="text-2xl font-bold text-text-primary mb-3">Excellence</h3>
          <p class="text-text-tertiary leading-relaxed">
            We strive for excellence in everything we do, from our facilities to
            our service
          </p>
        </div>
        <div
          class="bg-bg-secondary p-8 rounded-xl border border-border-primary text-center hover:border-border-accent transition-all"
        >
          <div
            class="w-20 h-20 bg-primary/10 rounded-lg flex items-center justify-center mx-auto mb-6"
          >
            <i class="ri-hand-heart-line text-4xl text-primary"></i>
          </div>
          <h3 class="text-2xl font-bold text-text-primary mb-3">Community</h3>
          <p class="text-text-tertiary leading-relaxed">
            Building a supportive community where everyone can thrive together
          </p>
        </div>
        <div
          class="bg-bg-secondary p-8 rounded-xl border border-border-primary text-center hover:border-border-accent transition-all"
        >
          <div
            class="w-20 h-20 bg-primary/10 rounded-lg flex items-center justify-center mx-auto mb-6"
          >
            <i class="ri-focus-3-line text-4xl text-primary"></i>
          </div>
          <h3 class="text-2xl font-bold text-text-primary mb-3">Results</h3>
          <p class="text-text-tertiary leading-relaxed">
            Focused on delivering real, measurable results for every member
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- History/Timeline Section -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-text-primary mb-12 text-center">
        My Journey
      </h2>
      <div class="max-w-4xl mx-auto">
        <div class="relative">
          <!-- Timeline Line -->
          <div
            class="absolute left-8 top-0 bottom-0 w-0.5 bg-primary/30 hidden md:block"
          >
          </div>

          <div class="space-y-12">
            {
              history.map((milestone, index) => (
                <div class="relative flex items-start gap-6">
                  <div class="hidden md:block shrink-0">
                    <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center border-4 border-bg-primary">
                      <span class="text-bg-primary font-bold text-sm">
                        {milestone.year}
                      </span>
                    </div>
                  </div>
                  <div class="flex-1 bg-bg-secondary p-6 rounded-xl border border-border-primary hover:border-border-accent transition-all">
                    <div class="md:hidden mb-2">
                      <span class="bg-primary text-bg-primary px-3 py-1 rounded-full text-sm font-bold">
                        {milestone.year}
                      </span>
                    </div>
                    <h3 class="text-2xl font-bold text-text-primary mb-2">
                      {milestone.title}
                    </h3>
                    <p class="text-text-secondary leading-relaxed">
                      {milestone.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

---
import FAQ from "../components/FAQ.astro";
import Layout from "../layouts/Layout.astro";
import PricingServiceCategories from "../components/PricingServiceCategories.astro";
import PricingGroupTrainingTables from "../components/PricingGroupTrainingTables.astro";
import PricingNutritionSupportTable from "../components/PricingNutritionSupportTable.astro";
import PricingOutdoorTrainingTable from "../components/PricingOutdoorTrainingTable.astro";
import PricingTrainingPackagesTable from "../components/PricingTrainingPackagesTable.astro";
import type { Locale } from "../i18n/config";
import { getSiteContent } from "../data/getSiteContent";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { siteData, paymentOptions, pricingFaqs, pages, contactHref } =
  getSiteContent(locale);
const copy = pages.pricing;
---

<Layout title={`${copy.heroTitle} - ${siteData.name}`} description={copy.metaDescription}>
  <section class="page-hero-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
          {copy.heroTitle}
        </h1>
        <p class="text-xl text-text-secondary">{copy.heroSubtitle}</p>
      </div>

      <PricingTrainingPackagesTable />
      <PricingGroupTrainingTables />
      <PricingOutdoorTrainingTable />
      <PricingNutritionSupportTable />
      <PricingServiceCategories categories={paymentOptions.categories} />
    </div>
  </section>

  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-text-primary mb-12 text-center">
        {copy.paymentTitle}
      </h2>
      <div class="max-w-4xl mx-auto">
        <div
          class="bg-bg-primary p-8 rounded-xl border border-border-primary mb-8"
        >
          <h3 class="text-2xl font-bold text-text-primary mb-6 text-center">
            {copy.paymentMethodsTitle}
          </h3>
          <div class="flex flex-wrap justify-center gap-4">
            {
              paymentOptions.methods.map((method) => (
                <div class="bg-bg-secondary px-6 py-3 rounded-lg border border-border-primary">
                  <span class="text-text-secondary font-medium">{method}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div
            class="bg-primary/10 border border-border-accent/30 p-6 rounded-xl text-center"
          >
            <i class="ri-group-line text-4xl text-primary mb-4"></i>
            <h4 class="text-xl font-bold text-text-primary mb-2">
              {paymentOptions.freeSeasonalClass.title}
            </h4>
            <p class="text-text-secondary">
              {paymentOptions.freeSeasonalClass.description}
            </p>
          </div>
          <div
            class="bg-primary/10 border border-border-accent/30 p-6 rounded-xl text-center"
          >
            <i class="ri-gift-line text-4xl text-primary mb-4"></i>
            <h4 class="text-xl font-bold text-text-primary mb-2">
              {paymentOptions.freeConsultation.title}
            </h4>
            <p class="text-text-secondary">
              {paymentOptions.freeConsultation.description}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FAQ
    id="payment-questions"
    items={pricingFaqs}
    title={copy.faqSectionTitle}
    showFooter={false}
  />

  <section class="section-cta-gradient">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-bg-primary mb-4">
        {copy.ctaTitle}
      </h2>
      <p class="text-xl text-bg-primary/90 mb-8 max-w-2xl mx-auto">
        {copy.ctaBody}
      </p>
      <a
        href={contactHref}
        class="btn-interactive inline-flex items-center justify-center gap-3 rounded-lg bg-bg-primary px-8 py-4 text-lg font-bold text-text-primary shadow-lg hover:bg-bg-secondary"
      >
        {copy.ctaButton}
        <i class="ri-arrow-right-line"></i>
      </a>
    </div>
  </section>
</Layout>

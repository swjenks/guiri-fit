---
import Layout from "../../layouts/Layout.astro";
import type { Locale } from "../../i18n/config";
import { getSiteContent } from "../../data/getSiteContent";

const locale = (Astro.currentLocale ?? "en") as Locale;
const {
  classes,
  isServiceComingSoon,
  serviceComingSoonMessage,
  siteData,
  serviceCta,
  pages,
} = getSiteContent(locale);
const copy = pages.services;
const heroDetail =
  locale === "es"
    ? "Personal, grupos reducidos, interior, exterior: lo que busques, lo tenemos."
    : "1-on-1, private groups, indoor, outdoor - whatever you're looking for, I've got you covered.";
---

<Layout title={`${copy.heroTitle} - ${siteData.name}`} description={copy.metaDescription}>
  <section class="page-hero-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
          {copy.heroTitle}
        </h1>
        <p class="text-xl text-text-secondary">{heroDetail}</p>
      </div>

      <div class="space-y-16">
        {
          classes.map((classItem) => {
            const comingSoon = isServiceComingSoon(classItem.slug);

            return (
              <div
                id={`service-${classItem.slug}`}
                class:list={[
                  "scroll-mt-28 overflow-hidden rounded-xl border border-border-primary bg-bg-primary",
                  comingSoon ? "service-coming-soon" : "card-interactive",
                ]}
              >
                {comingSoon && (
                  <div class="service-coming-soon__overlay">
                    <p class="service-coming-soon__label">
                      {serviceComingSoonMessage}
                    </p>
                  </div>
                )}
                <div class="grid grid-cols-1 lg:grid-cols-2">
                  <div class="relative h-64 lg:h-auto lg:min-h-[400px]">
                    <img
                      src={classItem.image}
                      alt={classItem.name}
                      class="absolute inset-0 h-full w-full object-cover"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-8 lg:p-12">
                    <h2 class="text-3xl font-bold text-text-primary mb-4">
                      {classItem.name}
                    </h2>
                    <p class="text-text-secondary mb-6 leading-relaxed">
                      {classItem.detailedDescription}
                    </p>

                    <div class="grid grid-cols-2 gap-4 mb-6">
                      <div>
                        <p class="text-sm text-text-tertiary mb-1">
                          {locale === "es" ? "Duración" : "Duration"}
                        </p>
                        <p class="font-semibold text-text-primary">
                          {classItem.duration}
                        </p>
                      </div>
                      <div>
                        <p class="text-sm text-text-tertiary mb-1">
                          {locale === "es" ? "Nivel" : "Difficulty"}
                        </p>
                        <p class="font-semibold text-text-primary">
                          {classItem.difficulty}
                        </p>
                      </div>
                    </div>

                    <h3 class="text-lg font-bold text-text-primary mb-3">
                      {locale === "es" ? "Beneficios" : "Benefits"}
                    </h3>
                    <ul class="space-y-2 mb-6">
                      {
                        classItem.benefits.map((benefit) => (
                          <li class="flex items-start gap-2 text-text-secondary">
                            <i class="ri-check-line text-primary mt-1 shrink-0" />
                            <span>{benefit}</span>
                          </li>
                        ))
                      }
                    </ul>

                    <h3 class="text-lg font-bold text-text-primary mb-3">
                      {locale === "es" ? "Qué esperar" : "What to Expect"}
                    </h3>
                    <p class="text-text-secondary mb-8 leading-relaxed">
                      {classItem.whatToExpect}
                    </p>

                    {!comingSoon &&
                      (() => {
                        const cta = serviceCta(classItem.slug, "detail");
                        return (
                          <a
                            href={cta.href}
                            class="inline-flex items-center gap-2 bg-primary hover:bg-primary-hover text-bg-primary px-6 py-3 rounded-lg font-semibold transition-all"
                            {...(cta.external
                              ? { target: "_blank", rel: "noopener noreferrer" }
                              : {})}
                          >
                            {cta.label}
                            <i
                              class={
                                classItem.slug === "community"
                                  ? "ri-whatsapp-line"
                                  : "ri-arrow-right-line"
                              }
                            />
                          </a>
                        );
                      })()}
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>

{
  "extends": "./tsconfig.preset.json",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ],
    "paths": {
      "@data/*": ["./src/data/*"],
      "@assets/*": ["./src/assets/*"]
    }
  }
}
